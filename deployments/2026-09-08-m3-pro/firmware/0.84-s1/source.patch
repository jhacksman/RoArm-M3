+bool jointFeedbackValid = false;
+uint32_t jointFeedbackSampleTime = 0;
+uint32_t jointFeedbackSampleDuration = 0;
+float motionSupplyVoltage = 0.0f;
+uint32_t espNowMotionBlockedCycles = 0;
+uint32_t espNowMotionTxFrames = 0;
+
+// Read the INA219 bus register directly so an I2C error cannot leave a cached
+// voltage authorizing motion. The library helper does not expose read errors.
+bool readMotionSupply() {
+  motionSupplyVoltage = 0.0f;
+  Wire.beginTransmission(INA219_ADDRESS);
+  Wire.write(static_cast<uint8_t>(0x02));
+  if (Wire.endTransmission(false) != 0) return false;
+  if (Wire.requestFrom(static_cast<uint8_t>(INA219_ADDRESS),
+                       static_cast<uint8_t>(2)) != 2) return false;
+  const uint8_t high = Wire.read();
+  const uint8_t low = Wire.read();
+  const uint16_t raw = (static_cast<uint16_t>(high) << 8) | low;
+  motionSupplyVoltage = static_cast<float>(raw >> 3) * 0.004f;
+  return !(raw & 1) && FeedbackSafety::voltageValid(
+      motionSupplyVoltage, Protective_voltage_min / 100.0f,
+      Protective_voltage / 100.0f);
+}
+
+bool motionStreamingAllowed() {
+  const bool supplyOK = readMotionSupply();
+  return FeedbackSafety::canStream(jointFeedbackValid, supplyOK, millis(),
+                                  jointFeedbackSampleTime,
+                                  jointFeedbackSampleDuration);
+}
+
+bool allowEspNowMotion() {
+  const bool allowed = motionStreamingAllowed();
+  static bool reported = false;
+  static bool lastAllowed = false;
+  if (!reported || allowed != lastAllowed) {
+    Serial.println(allowed ? "ESP-NOW motion ready: valid supply and fresh joints."
+                           : "ESP-NOW motion blocked: invalid supply or joint feedback.");
+    reported = true;
+    lastAllowed = allowed;
+  }
+  if (!allowed) ++espNowMotionBlockedCycles;
+  return allowed;
+}
